APP_NAME="Tourlast Sales Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://sales.tourlast.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sales@tourlast.com"
MAIL_FROM_NAME="Tourlast Sales"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Tourlast Sales Hub"

# --- Sales Hub rules (config/hub.php) ---
HUB_LIST_PROPERTY_URL=https://www.tourlast.com/list-your-property
HUB_REFERRAL_PREFIX=TL
HUB_INVITATION_EXPIRY_DAYS=7
HUB_TARGET_LOCK_DAY=7
HUB_STALLED_AFTER_DAYS=14
HUB_INACTIVE_AFTER_DAYS=3
HUB_DEFAULT_COUNTRY=Kenya
# Monthly transport claim cap per salesperson in KES (leave empty for no cap)
HUB_TRANSPORT_MONTHLY_CAP=

# --- tourlast.com connection (config/tourlast.php, docs/TOURLAST_INTEGRATION.md) ---
# sandbox = sample data in this app | database = read-only DB | api = read-only JSON endpoint
# sandbox (simulator), database or api (the Hub reads tourlast.com), or push (tourlast.com calls the Hub API)
TOURLAST_SOURCE=sandbox
TOURLAST_SYNC_EVERY_MINUTES=10
TOURLAST_FULL_SYNC_AT=02:00

# Read-only database (TOURLAST_SOURCE=database). Grant SELECT only.
TOURLAST_DB_HOST=
TOURLAST_DB_PORT=3306
TOURLAST_DB_DATABASE=
TOURLAST_DB_USERNAME=sales_hub_readonly
TOURLAST_DB_PASSWORD=
TOURLAST_DB_TABLE=properties
# Column names on the tourlast.com table (defaults shown in config/tourlast.php)
# TOURLAST_COL_PROPERTY_ID=id
# TOURLAST_COL_REF_CODE=ref_code
# TOURLAST_COL_NAME=name
# TOURLAST_COL_TYPE=property_type
# TOURLAST_COL_LOCATION=city
# TOURLAST_COL_CONTACT_NAME=contact_name
# TOURLAST_COL_CONTACT_PHONE=contact_phone
# TOURLAST_COL_CONTACT_EMAIL=contact_email
# TOURLAST_COL_STATUS=status
# TOURLAST_COL_SUBMITTED_AT=created_at
# TOURLAST_COL_APPROVED_AT=approved_at
# TOURLAST_COL_ACTIVE_AT=published_at
# TOURLAST_COL_REJECTED_AT=rejected_at
# TOURLAST_COL_UPDATED_AT=updated_at

# Read-only API (TOURLAST_SOURCE=api)
TOURLAST_API_URL=https://www.tourlast.com
TOURLAST_API_PATH=/api/sales-hub/referrals
TOURLAST_API_TOKEN=

# Optional instant updates: POST {APP_URL}/webhooks/tourlast signed with this secret
TOURLAST_WEBHOOK_SECRET=
