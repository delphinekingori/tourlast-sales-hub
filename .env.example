APP_NAME="Tourlast Sales Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://sales.tourlast.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sales@tourlast.com"
MAIL_FROM_NAME="Tourlast Sales"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Tourlast Sales Hub"

# --- Sales Hub rules (config/hub.php) ---
HUB_LIST_PROPERTY_URL=https://www.tourlast.com/list-your-property
HUB_REFERRAL_PREFIX=TL
HUB_INVITATION_EXPIRY_DAYS=7
HUB_TARGET_LOCK_DAY=7
HUB_STALLED_AFTER_DAYS=14
HUB_INACTIVE_AFTER_DAYS=3
HUB_DEFAULT_COUNTRY=Kenya
# Monthly transport claim cap per salesperson in KES (leave empty for no cap)
HUB_TRANSPORT_MONTHLY_CAP=

# --- tourlast.com connection (config/tourlast.php, docs/TOURLAST_INTEGRATION.md) ---
# api = read-only JSON from source apps (the only supported connection) | push = source apps push into this Hub | sandbox = sample data in this app
# Demo data (DemoSeeder) only seeds when APP_ENV=local AND TOURLAST_SOURCE=sandbox. Never use sandbox in production.
TOURLAST_SOURCE=api
TOURLAST_SYNC_EVERY_MINUTES=10
TOURLAST_FULL_SYNC_AT=02:00

# One shared token, both directions. Generate it with php artisan hub:generate-token:
# the Hub sends it to the source apps as TOURLAST_API_TOKEN, they send the same value
# back as TOURLAST_HUB_TOKEN, and it is also what POST /integrations/tourlast/providers accepts.
# Read-only API (TOURLAST_SOURCE=api). The Hub never opens another app's database.
# One or more source app bases, comma separated.
TOURLAST_API_URL=https://www.tourlast.com
TOURLAST_API_PATH=/api/sales-hub/referrals
TOURLAST_API_TOKEN=

# Optional instant updates: POST {APP_URL}/webhooks/tourlast signed with this secret
TOURLAST_WEBHOOK_SECRET=

# --- Live notifications (config/broadcasting.php) ---
# The Reverb server runs on another site. Set BROADCAST_CONNECTION=reverb and fill these in
# (same app id, key and secret as that server). Leave them empty and the bell polls instead.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
